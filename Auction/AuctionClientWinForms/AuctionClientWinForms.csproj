<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuctionClientWinForms</RootNamespace>
    <AssemblyName>AuctionClientWinForms</AssemblyName>
    <BaseOutputPath>..\..\Out\AuctionClientWinForms\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CSharp\ClientNetwork\ClientNetwork.csproj" />
    <ProjectReference Include="..\..\Generated\GameData\CSharp\GeneratedGameData.csproj" />
    <ProjectReference Include="..\..\Generated\Packets\CSharp\GeneratedPackets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClientAdaptersCSharpSmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Generated\GameData\Data\Client\Item.json" Link="GameData\Item.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Generated\GameData\Data\Client\Currency.json" Link="GameData\Currency.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
