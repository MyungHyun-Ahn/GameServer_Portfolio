<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\..\Out\GameDataCSharpSmokeTest\</BaseOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Generated\GameData\CSharp\GeneratedGameData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Generated\GameData\Data\Client\Item.json"
          Link="GameData\Item.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Generated\GameData\Data\Client\Map.json"
          Link="GameData\Map.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Generated\GameData\Data\Client\Monster.json"
          Link="GameData\Monster.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Generated\GameData\Data\Client\Character.json"
          Link="GameData\Character.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Generated\GameData\Data\Client\Currency.json"
          Link="GameData\Currency.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
